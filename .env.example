# ============================================================
# .env.example - Copie para .env e preencha
# ============================================================
# NUNCA commite .env (ja esta no .gitignore)
# NUNCA use estes valores em producao

# === Django ===
DJANGO_SETTINGS_MODULE=config.settings.dev
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=substitua-por-token-aleatorio-de-50-chars-urlsafe
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# === Banco ===
DATABASE_URL=postgres://prontuario:dev_only_change_in_prod@db:5432/prontuario_dev

# === Cache / Filas ===
REDIS_URL=redis://redis:6379/0

# === NAO USE EM PROD - exemplos abaixo ===
# EMAIL_HOST=smtp.locaweb.com.br
# EMAIL_PORT=587
# EMAIL_HOST_USER=nao-responda@espacodesenvolver.com.br
# EMAIL_HOST_PASSWORD=senha-smtp
# DEFAULT_FROM_EMAIL=nao-responda@espacodesenvolver.com.br
# CORS_ALLOWED_ORIGINS=https://app.espacodesenvolver.com.br,https://portal.espacodesenvolver.com.br

